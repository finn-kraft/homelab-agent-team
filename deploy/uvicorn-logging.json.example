{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "structured": {
      "()": "agent_core.structured_logging.StructuredJsonFormatter",
      "service": "homelab-routing-agent"
    }
  },
  "handlers": {
    "structured": {
      "class": "logging.StreamHandler",
      "formatter": "structured",
      "stream": "ext://sys.stderr"
    }
  },
  "loggers": {
    "uvicorn": {"handlers": ["structured"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["structured"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": ["structured"], "level": "INFO", "propagate": false}
  }
}
