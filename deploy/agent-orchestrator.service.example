[Unit]
Description=Homelab Agent Team Orchestrator
After=network-online.target postgresql.service homelab-routing-agent.service
Wants=network-online.target
PartOf=agent-team.target

[Service]
Type=simple
User=finn
WorkingDirectory=/home/finn/homelab-ai/dev-team
EnvironmentFile=/home/finn/homelab-ai/dev-team/.env
ExecStart=/home/finn/homelab-ai/dev-team/.venv/bin/agent-orchestrator run
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=900
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-orchestrator
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

[Install]
WantedBy=multi-user.target
