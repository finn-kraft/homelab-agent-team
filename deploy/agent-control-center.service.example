[Unit]
Description=Homelab Agent Team Control Center
After=network-online.target postgresql.service agent-orchestrator.service
Wants=network-online.target
PartOf=agent-team.target

[Service]
Type=simple
User=finn
WorkingDirectory=/home/finn/homelab-ai/dev-team
EnvironmentFile=/home/finn/homelab-ai/dev-team/.env
ExecStart=/home/finn/homelab-ai/dev-team/.venv/bin/agent-control-center
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/finn/work
UMask=0077

[Install]
WantedBy=multi-user.target
