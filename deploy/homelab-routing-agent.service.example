[Unit]
Description=Homelab Agent Team Inference Router
After=network-online.target
Wants=network-online.target
PartOf=agent-team.target

[Service]
Type=simple
User=finn
WorkingDirectory=/home/finn/homelab-ai/dev-team/homelab-routing-agent/routing-agent
EnvironmentFile=-/home/finn/homelab-ai/dev-team/.env
ExecStart=/home/finn/homelab-ai/dev-team/.venv/bin/python -m uvicorn routing_agent.api:app --host 127.0.0.1 --port 8090 --log-config /home/finn/homelab-ai/dev-team/deploy/uvicorn-logging.json.example
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-routing-agent
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

[Install]
WantedBy=multi-user.target
