# PostgreSQL is the durable source of workflow state.  Use a restricted
# application role; do not put production-owner credentials here.
# Add authentication locally (or use .pgpass/a secret-injected URL).
DATABASE_URL=postgresql://agent_team_app@127.0.0.1:5432/agent_team

# Only needed by the optional development Compose database. Keep the password
# itself outside this repository and point Compose at its mode-0600 file.
AGENT_POSTGRES_USER=agent_team_dev
AGENT_POSTGRES_DATABASE=agent_team_dev
AGENT_POSTGRES_PASSWORD_FILE=/home/finn/.config/agent-team/postgres-password

# JSON application logs go to stderr/journald. Repository content, prompts,
# command output, and known secret fields are omitted/redacted.
AGENT_LOG_LEVEL=INFO

# Repository allow-roots.  Paths are separated with ':' on Linux/macOS and ';'
# on Windows.  The initial Align worker checkout must already be on this branch.
PLANNER_ALLOWED_REPOSITORIES=/home/finn/work
ENGINEERING_WORKSPACES=/home/finn/work
# Legacy alias accepted during the V1 migration:
CODER_WORKSPACES=/home/finn/work
ENGINEERING_WORKTREE_ROOT=/home/finn/agent-worktrees
REVIEWER_ALLOWED_REPOSITORIES=/home/finn/work

PLANNER_WORKER_ID=planner-1
ENGINEERING_WORKER_ID=engineering-1
# Legacy alias accepted during the V1 migration:
CODER_WORKER_ID=engineering-1
REVIEWER_WORKER_ID=reviewer-1
ORCHESTRATOR_WORKER_ID=orchestrator-1

# The Routing Agent selects compute/model policy; the Orchestrator still owns
# workflow transitions.  A temporary Router outage falls back to Ollama.
ROUTER_URL=http://127.0.0.1:8090
OLLAMA_URL=http://192.168.10.193:11434
PLANNER_MODEL=qwen2.5-coder:7b-instruct
ENGINEERING_MODEL=qwen2.5-coder:7b-instruct
# Legacy alias accepted during the V1 migration:
CODER_MODEL=qwen2.5-coder:7b-instruct
REVIEWER_MODEL=qwen2.5-coder:7b-instruct
# Bound slow/unavailable model calls so an agent does not hold a lease for
# several minutes before failover. Ollama and OpenRouter can be tuned separately.
# Increase the local timeout if your GPU needs longer for a large response.
LLM_TIMEOUT_SECONDS=60
LLM_RETRIES=0
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_RETRIES=0
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_RETRIES=1
ENGINEERING_MAX_CONTEXT_CHARS=120000
# Legacy alias accepted during the V1 migration:
CODER_MAX_CONTEXT_CHARS=120000
PLANNER_MAX_CONTEXT_CHARS=120000
REVIEWER_MAX_CONTEXT_CHARS=120000
PLANNER_MAX_DOCUMENT_BYTES=50000
PLANNER_MAX_TREE_ENTRIES=500
REVIEWER_MAX_DOCUMENT_CHARS=20000
REVIEWER_MAX_COMMAND_OUTPUT_CHARS=50000
# The planner may queue up to this many coherent sequential steps in one pass;
# the Engineer/reviewer/verifier pipeline consumes them before replanning.
PLANNER_PACKAGE_STEPS=3
# Keep planning short: one repair retry after the initial decision.
PLANNER_DECISION_RETRIES=1

# Optional and intentionally a backup.  Do not add an actual key to this file.
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_CIRCUIT_SECONDS=60
OPENROUTER_PLANNER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_REVIEWER_MODEL=anthropic/claude-sonnet-4

# Ollama is used through attempts 1-3. Cloud eligibility begins at attempt 4;
# set INFERENCE_LOCAL_ATTEMPTS instead when you prefer an agent-specific default.
INFERENCE_ESCALATE_AFTER=4
# Set true for repositories that must never use the cloud fallback.
INFERENCE_PRIVACY_SENSITIVE=false
MAX_ENGINEERING_ATTEMPTS=5
# Legacy alias accepted during the V1 migration:
# MAX_CODER_ATTEMPTS is used only when MAX_ENGINEERING_ATTEMPTS is unset.
MAX_CODER_ATTEMPTS=5
MAX_REVIEW_ATTEMPTS=5
MISSION_PACKAGE_LIMIT=3
# Allow one active mutation job per source repository by default. Set higher
# only when the repository and model budget can safely support parallel work.
ORCHESTRATOR_MAX_CONCURRENT_PER_REPOSITORY=1
# Maximum ready package backlog (0 disables this admission cap).
ORCHESTRATOR_QUEUE_BACKPRESSURE=0
ORCHESTRATOR_WORKTREE_CLEANUP_SECONDS=60
# Keep false until the mission branch integration policy is reviewed.
AUTO_INTEGRATE=false
# No overall Engineering turn cutoff: productive work continues until finish,
# pause, or stagnation detection. Set a positive value only for a temporary
# compatibility cap while debugging a specific model.
ENGINEERING_TURN_LIMIT=0
ENGINEERING_MAX_STAGNATION_EPISODES=6
ENGINEERING_MAX_PROMPT_TOKENS=0
PLANNER_MAX_PROMPT_TOKENS=0
REVIEWER_MAX_PROMPT_TOKENS=0
ENGINEERING_ALLOWED_PROVIDERS=ollama,openrouter
PLANNER_ALLOWED_PROVIDERS=ollama,openrouter
REVIEWER_ALLOWED_PROVIDERS=ollama,openrouter
# Optional cloud spend/latency guardrails per agent (0 disables each cap).
ENGINEERING_MAX_CLOUD_COST=0
PLANNER_MAX_CLOUD_COST=0
REVIEWER_MAX_CLOUD_COST=0
ENGINEERING_MAX_LATENCY_SECONDS=0
PLANNER_MAX_LATENCY_SECONDS=0
REVIEWER_MAX_LATENCY_SECONDS=0
# ENGINEERING_MAX_TURNS and CODER_MAX_TURNS are deprecated and ignored.

ORCHESTRATOR_POLL_SECONDS=10
ORCHESTRATOR_LEASE_SECONDS=300
ORCHESTRATOR_REPOSITORY_LOCK_SECONDS=900
ORCHESTRATOR_VERIFICATION_TIMEOUT_SECONDS=900
PROTECTED_BRANCHES=main,master
AUTO_COMMIT=true
AUTO_PUSH=false

# Authenticated operations dashboard. Bind to 127.0.0.1 behind a TLS proxy, or to
# the server's LAN IP for a trusted private network. Password is stored as a bcrypt
# hash in PostgreSQL; it is never placed in this file.
CONTROL_CENTER_HOST=127.0.0.1
CONTROL_CENTER_PORT=8080
CONTROL_CENTER_COOKIE_SECURE=false
# Session policy: viewer is read-only; admin/operator may run controls.
CONTROL_CENTER_ROLE=operator
CONTROL_CENTER_SESSION_TTL_SECONDS=43200
CONTROL_CENTER_SESSION_IDLE_SECONDS=21600
CONTROL_CENTER_WRITE_RATE_LIMIT=120
# Explicit repository allowlist exposed in the UI. Keep this JSON on one line.
CONTROL_CENTER_PROJECTS='[{"id":"align","name":"Align","repository":"/home/finn/work/align","branch":"agents/autonomous-align","roadmap":"docs/roadmap.md"}]'
# Optional trusted read-only telemetry endpoint on the Ollama host.
# GPU_TELEMETRY_URL=http://192.168.10.193:9400/v1/gpu
# GPU_TELEMETRY_TOKEN=inject-from-secret-store

# Optional explicit argv commands.  If unset, verification reads only explicit
# backtick-delimited commands under ## Verification in WORKER.md / AGENTS.md.
# ORCHESTRATOR_VERIFICATION_COMMANDS='[["pytest","-q"],["ruff","check","."]]'
